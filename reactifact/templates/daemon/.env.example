APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=reactifact-daemon

# ── loop ───────────────────────────────────────────────────────────────
APP_INTERVAL_SECONDS=60
APP_RUN_ONCE=false

# ── LLM (none = offline; set a real provider to use the structured monitor) ──
APP_LLM_PROVIDER=none
# APP_LLM_PROVIDER=deepseek
# APP_LLM_MODEL=<your-model>
# APP_LLM_API_KEY_ENV=DEEPSEEK_API_KEY

# Custom OpenAI-compatible gateway (LiteLLM, vLLM, …)
# APP_LLM_PROVIDER=custom
# APP_LLM_BASE_URL=http://litellm:4000/v1
# APP_LLM_MODEL=<your-model-alias>
# APP_LLM_API_KEY_ENV=LITELLM_MASTER_KEY

# ── per-tick budget ────────────────────────────────────────────────────
APP_BUDGET_MAX_RUNS=20
APP_BUDGET_MAX_ITERATIONS=10
APP_BUDGET_MAX_SECONDS=60
APP_BUDGET_MAX_TOOL_CALLS=4
APP_BUDGET_MAX_TOKENS=20000
APP_BUDGET_MAX_COST=0.10

APP_TRACING_ENABLED=true
APP_TRACE_PATH=./data/traces.db
APP_AGENT_TIMEOUT_SECONDS=60
APP_PRINCIPAL_ID=daemon
