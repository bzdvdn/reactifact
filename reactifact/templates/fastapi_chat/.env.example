# ── app ────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_AUTH_TOKEN=change-me
APP_AUTH_USER_ID=demo
APP_AUTH_USERNAME=demo
APP_AUTH_CAPABILITIES=user

# ── LLM ───────────────────────────────────────────────────────────────
# Default: offline/fallback mode. Uncomment a provider block and set a model.
APP_LLM_PROVIDER=none
# APP_LLM_MODEL=

# OpenRouter
# APP_LLM_PROVIDER=openrouter
# APP_LLM_MODEL=<provider/model>
# APP_LLM_API_KEY_ENV=OPENROUTER_API_KEY

# DeepSeek
# APP_LLM_PROVIDER=deepseek
# APP_LLM_MODEL=<your-model>

# Groq
# APP_LLM_PROVIDER=groq
# APP_LLM_MODEL=<your-model>

# Any OpenAI-compatible gateway (LiteLLM, vLLM, LM Studio, llama.cpp, …)
# APP_LLM_PROVIDER=custom
# APP_LLM_BASE_URL=http://litellm:4000/v1
# APP_LLM_MODEL=<your-model-alias>
# APP_LLM_API_KEY_ENV=LITELLM_MASTER_KEY

# Anthropic native API
# APP_LLM_PROVIDER=anthropic
# APP_LLM_MODEL=<your-model>

# ── budget (per turn) ─────────────────────────────────────────────────
APP_BUDGET_MAX_RUNS=120
APP_BUDGET_MAX_ITERATIONS=100
APP_BUDGET_MAX_SECONDS=120
APP_BUDGET_MAX_TOOL_CALLS=12
APP_BUDGET_MAX_TOKENS=120000
APP_BUDGET_MAX_COST=0.50

# ── chat / agents ─────────────────────────────────────────────────────
APP_AGENT_TIMEOUT_SECONDS=60
APP_CHAT_MAX_CONCURRENCY=4
APP_CHAT_MEMORY_KEEP=20
APP_CHAT_MEMORY_COMMITS=500
APP_CHAT_SESSION_SAVE_POLICY=per_commit
APP_TRACING_ENABLED=true

# ── stores ────────────────────────────────────────────────────────────
# memory | file | sqlite | postgres
APP_SESSION_BACKEND=sqlite
APP_SESSION_PATH=./data/sessions.db
# APP_SESSION_URL=postgresql://user:pass@localhost:5432/sessions

APP_TRACE_BACKEND=sqlite
APP_TRACE_PATH=./data/traces.db

# ── optional RAG ──────────────────────────────────────────────────────
APP_RAG_ENABLED=false
APP_QDRANT_URL=http://localhost:6333
# APP_EMBEDDING_BASE_URL=http://litellm:4000/v1
# APP_EMBEDDING_MODEL=<your-embedding-model>
# APP_EMBEDDING_API_KEY_ENV=LITELLM_MASTER_KEY
