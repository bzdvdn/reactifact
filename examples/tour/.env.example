# Copy to `.env` and pick ONE provider for `--scene model --llm`.
# Without it the tour runs fully offline; the model scene uses a deterministic
# brief instead of pretending a model answered.

# --- OpenRouter (default when present) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
