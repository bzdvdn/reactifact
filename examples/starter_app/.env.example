# Copy to `.env` and pick ONE provider. With neither set, the app runs offline:
# the chat/tools/agent cases return an honest fallback, and `rag` still answers
# from knowledge/ with citations.

# --- OpenRouter (default when present) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Optional: protect the /traces dashboard with basic auth ---
# TRACE_USER=admin
# TRACE_PASSWORD=change-me
